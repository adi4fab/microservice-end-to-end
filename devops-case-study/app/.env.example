# Copy this file to .env.local and fill in your values.
# Load it when running:
#   docker run --env-file .env.local ...
#   (or locally without Docker: node --env-file=.env.local src/server.js)

# ---------------------------------------------------------------------------
# Option A — AWS Secrets Manager (recommended)
# Set SECRET_ID to the name/ARN of a secret holding JSON like:
#   {"S3_BUCKET":"my-bucket","AWS_REGION":"us-east-1"}
# ---------------------------------------------------------------------------
SECRET_ID=

# Bootstrap region used to reach Secrets Manager (and the default S3 region).
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Option B — plain env (used only when SECRET_ID is empty)
# ---------------------------------------------------------------------------
S3_BUCKET=REPLACE_ME_BUCKET

# HTTP port (default 8080).
PORT=8080
